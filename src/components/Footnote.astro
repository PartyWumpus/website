---
export interface Props {
  count: number;
}

const { count } = Astro.props;
---

<style>
  .footnote-popover {
    color: white;
    border: none;
    position-anchor: var(--my-anchor);
    top: auto;
    bottom: anchor(top);
    justify-self: anchor-center;
    margin-left: 30px;
    margin-right: 30px;
    margin-bottom: 9px;
    max-width: 500px;
    padding: 10px;
    background: rgb(var(--bg-2));
    border-radius: 8px;
  }

  .footnote-popover::after {
    position-anchor: var(--my-anchor);
    content: "";
    position: fixed;
    bottom: anchor(top);
    justify-self: anchor-center;
    border: calc(10px) solid transparent;
    border-bottom-width: 0;
    border-top-color: rgb(var(--bg-2));
    width: 0;
    height: 0;
    animation: popover-in 0.2s ease;
  }

  .footnote-button {
    all: unset;
    color: rgb(var(--accent));
    cursor: pointer;
    anchor-name: var(--my-anchor);
  }
</style>

<span
  id=`footnote-${count}`
  class="footnote-popover"
  popover="auto"
  style=`--my-anchor:--footnote-${count}`
>
  <slot />
</span><button
  class="footnote-button"
  popovertarget=`footnote-${count}`
  style=`--my-anchor:--footnote-${count}`
>
  <sup>{count}</sup>
</button>
